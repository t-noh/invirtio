# Hardening of a UML guest against bugs in the drivers and the rest of the
# code that runs in it. Merge with scripts/kconfig/merge_config.sh on top of
# a target's fragments, as invirtio-build-guest.sh -H does. kCFI needs Clang.
# Each option warns and does nothing on a host without the CPU feature it
# needs, except kCFI, which needs none.

# Returns are checked against host shadow stacks (CET).
CONFIG_UML_SHADOW_STACK=y

# Indirect calls are checked against the type of their target (kCFI).
CONFIG_CFI=y

# The VirtIO transport's state is kept out of the drivers' reach with memory
# protection keys (MPK).
CONFIG_UML_MPK=y
